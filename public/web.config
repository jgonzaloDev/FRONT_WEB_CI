<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <staticContent>
      <remove fileExtension=".json"/>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <rewrite>
      <rules>

        <!-- 1) Redirige el raíz / a /web/ -->
        <rule name="Root to /web/" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect" url="/web/" redirectType="Permanent" />
        </rule>

        <!-- 2) Assets bajo /web/... se sirven desde la raíz física (/js, /css, etc.) -->
        <rule name="Strip /web prefix for assets" stopProcessing="true">
          <match url="^web/(.*\.(?:js|css|map|png|jpe?g|gif|svg|ico|woff2?|ttf|eot|json))$" ignoreCase="true" />
          <action type="Rewrite" url="/{R:1}" />
        </rule>

        <!-- 3) Fallback SPA: cualquier /web/... sin extensión -> /index.html -->
        <rule name="SPA fallback /web" stopProcessing="true">
          <match url="^web(/.*)?$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="\.(?:js|css|map|png|jpe?g|gif|svg|ico|woff2?|ttf|eot|json)$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>

      </rules>
    </rewrite>

  </system.webServer>
</configuration>
